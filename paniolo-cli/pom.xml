<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.nalukit</groupId>
    <artifactId>paniolo-parent</artifactId>
    <version>${revision}</version>
  </parent>

  <artifactId>paniolo-cli</artifactId>

  <name>paniolo-cli</name>
  <description>Command line interface for Paniolo: validate, read, write, and convert invoices, orders, and despatch advices in
    scripts
  </description>

  <properties>
    <picocli.version>4.7.7</picocli.version>
    <plugin.shade.version>3.6.0</plugin.shade.version>
    <!-- GitHub Packages of the repository; the workflow passes -Dgithub.packages.url for the actual one -->
    <github.packages.url>https://maven.pkg.github.com/NaluKit/paniolo</github.packages.url>
  </properties>

  <!-- The CLI is not published to Maven Central (see excludeArtifacts in the release profile of the
       parent), but to GitHub Packages: mvn deploy -pl paniolo-cli after the other modules are installed. -->
  <distributionManagement>
    <repository>
      <id>github</id>
      <name>GitHub Packages</name>
      <url>${github.packages.url}</url>
    </repository>
    <snapshotRepository>
      <id>github</id>
      <name>GitHub Packages</name>
      <url>${github.packages.url}</url>
    </snapshotRepository>
  </distributionManagement>

  <dependencies>
    <dependency>
      <groupId>io.github.nalukit</groupId>
      <artifactId>paniolo</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.github.nalukit</groupId>
      <artifactId>paniolo-facturx</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- veraPDF is dual licensed (GPLv3+ / MPL-2.0); Paniolo uses it under MPL-2.0. -->
    <dependency>
      <groupId>io.github.nalukit</groupId>
      <artifactId>paniolo-pdfa</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.github.nalukit</groupId>
      <artifactId>paniolo-json</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.github.nalukit</groupId>
      <artifactId>paniolo-visualizer</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
    </dependency>
    <dependency>
      <groupId>info.picocli</groupId>
      <artifactId>picocli</artifactId>
      <version>${picocli.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
      </resource>
    </resources>
    <plugins>
      <!-- Executable jar with all dependencies: java -jar paniolo-cli-<version>-all.jar -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>${plugin.shade.version}</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <shadedArtifactAttached>true</shadedArtifactAttached>
              <shadedClassifierName>all</shadedClassifierName>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>META-INF/*.EC</exclude>
                    <exclude>META-INF/MANIFEST.MF</exclude>
                    <exclude>module-info.class</exclude>
                    <exclude>META-INF/versions/*/module-info.class</exclude>
                  </excludes>
                </filter>
                <!-- Paniolo's own Apache 2.0 license is META-INF/licenses/Apache-2.0.txt; the merged
                     META-INF/LICENSE keeps only the licenses of the bundled third-party libraries. -->
                <filter>
                  <artifact>io.github.nalukit:*</artifact>
                  <excludes>
                    <exclude>META-INF/LICENSE</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <!-- The facade finds paniolo-facturx and paniolo-pdfa through ServiceLoader. -->
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                <!-- Preserve non-Apache licenses (including Rhino's MPL), too. -->
                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                  <resource>META-INF/LICENSE</resource>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                  <resource>META-INF/LICENSE.txt</resource>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                  <resource>META-INF/LICENSE.md</resource>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheNoticeResourceTransformer"/>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>io.github.nalukit.paniolo.cli.PanioloCli</mainClass>
                  <manifestEntries>
                    <Implementation-Title>${project.artifactId}</Implementation-Title>
                    <Implementation-Version>${project.version}</Implementation-Version>
                    <Multi-Release>true</Multi-Release>
                  </manifestEntries>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
