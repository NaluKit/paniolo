<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.nalukit</groupId>
    <artifactId>paniolo-parent</artifactId>
    <version>${revision}</version>
  </parent>

  <artifactId>paniolo-visualizer</artifactId>

  <name>paniolo-visualizer</name>
  <description>Browser visualizer for invoices, orders, and despatch advices: a dependency-free web component that renders UBL,
    CII, Factur-X / ZUGFeRD PDFs, Order-X, and CIDA from bytes, with a Java helper for standalone HTML
  </description>

  <properties>
    <!-- The browser tests need a browser; they are compiled and run with -P browser-tests only. -->
    <browser.test.exclude>**/browser/**</browser.test.exclude>
    <playwright.version>1.65.1</playwright.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <testExcludes>
            <testExclude>${browser.test.exclude}</testExclude>
          </testExcludes>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      Runs the component in a real browser (Playwright for Java): the parser and the web component
      load UBL, CII, and PDF documents, show lines, attachments, and the validation report, switch the
      language, render untrusted text as text, and show errors.

        mvn verify -P browser-tests -pl paniolo-visualizer
        mvn verify -P browser-tests -pl paniolo-visualizer -Dpaniolo.browser.channel=chrome   # installed Chrome

      Without the property the Chromium of Playwright is used; install it once with
        mvn -P browser-tests -pl paniolo-visualizer exec:java -Dexec.mainClass=com.microsoft.playwright.CLI \
            -Dexec.classpathScope=test -Dexec.args="install chromium"
    -->
    <profile>
      <id>browser-tests</id>
      <properties>
        <browser.test.exclude>**/nothing-excluded/**</browser.test.exclude>
      </properties>
      <dependencies>
        <dependency>
          <groupId>com.microsoft.playwright</groupId>
          <artifactId>playwright</artifactId>
          <version>${playwright.version}</version>
          <scope>test</scope>
        </dependency>
      </dependencies>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <systemPropertyVariables>
                <paniolo.browser.channel>${paniolo.browser.channel}</paniolo.browser.channel>
              </systemPropertyVariables>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
