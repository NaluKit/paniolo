<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.nalukit</groupId>
    <artifactId>paniolo-parent</artifactId>
    <version>${revision}</version>
  </parent>
  <artifactId>test-paniolo-invoice-corpus</artifactId>
  <name>test-paniolo-invoice-corpus</name>
  <description>Pinned public invoice fixtures and repeatable validation regression tests</description>
  <properties>
    <maven.install.skip>true</maven.install.skip>
    <maven.deploy.skip>true</maven.deploy.skip>
  </properties>
  <dependencies>
    <dependency>
      <groupId>io.github.nalukit</groupId>
      <artifactId>paniolo-facturx</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- Only the separate PDF/A run (PdfaCorpusTest) sees it; see the surefire executions below. -->
    <dependency>
      <groupId>io.github.nalukit</groupId>
      <artifactId>paniolo-pdfa</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <executions>
          <!-- The baseline of the corpus: container and XML, without PDF/A (PDFA-NOT-CHECKED). -->
          <execution>
            <id>default-test</id>
            <configuration>
              <classpathDependencyExcludes>
                <classpathDependencyExclude>io.github.nalukit:paniolo-pdfa</classpathDependencyExclude>
              </classpathDependencyExcludes>
              <excludes>
                <exclude>**/PdfaCorpusTest.java</exclude>
              </excludes>
            </configuration>
          </execution>
          <!-- The additional run: PDF/A of the corpus PDFs with veraPDF and their own expectations. -->
          <execution>
            <id>pdfa-corpus</id>
            <phase>test</phase>
            <goals>
              <goal>test</goal>
            </goals>
            <configuration>
              <test>PdfaCorpusTest</test>
              <reportNameSuffix>pdfa</reportNameSuffix>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
