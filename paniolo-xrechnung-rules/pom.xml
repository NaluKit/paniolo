<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.nalukit</groupId>
    <artifactId>paniolo-parent</artifactId>
    <version>${revision}</version>
  </parent>

  <artifactId>paniolo-xrechnung-rules</artifactId>

  <name>paniolo-xrechnung-rules</name>
  <description>Official KoSIT XRechnung validator configuration packaged for paniolo-validation</description>

  <properties>
    <!-- Pinned KoSIT release; update all three values together. -->
    <xrechnung.version>3.0.2</xrechnung.version>
    <xrechnung.release>2026-08-31</xrechnung.release>
    <xrechnung.sha256>2530cd107c414511c5d0462ec10f886910395abfca820db82e83d70bf01221a8</xrechnung.sha256>
    <xrechnung.artifact>xrechnung-${xrechnung.version}-validator-configuration-${xrechnung.release}</xrechnung.artifact>

    <!-- Last KoSIT release of each older XRechnung version, for documents that state that version. -->
    <xrechnung.legacy12.version>1.2.2</xrechnung.legacy12.version>
    <xrechnung.legacy12.release>2019-12-30</xrechnung.legacy12.release>
    <xrechnung.legacy12.sha256>b9624c9f1c936e09ba99642b182b364aade921c95ffb6405e1ae49a4655b1740</xrechnung.legacy12.sha256>
    <xrechnung.legacy20.version>2.0.1</xrechnung.legacy20.version>
    <xrechnung.legacy20.release>2020-12-31</xrechnung.legacy20.release>
    <xrechnung.legacy20.sha256>2a8db484476854c7106196b1c214a3a5a30eea54438b3955d4647a9abeaf4415</xrechnung.legacy20.sha256>
    <xrechnung.legacy21.version>2.1.1</xrechnung.legacy21.version>
    <xrechnung.legacy21.release>2021-11-15</xrechnung.legacy21.release>
    <xrechnung.legacy21.sha256>837e77099cfd0a0b199fe2ebe78269ca29d01d99c038efed946d8a02806ce799</xrechnung.legacy21.sha256>
    <xrechnung.legacy22.version>2.2.0</xrechnung.legacy22.version>
    <xrechnung.legacy22.release>2022-11-15</xrechnung.legacy22.release>
    <xrechnung.legacy22.sha256>cd77d613f58d48df2bbcccbe53b636ac447d65f3914c1cbc3fa3a1edb1955a5b</xrechnung.legacy22.sha256>
    <xrechnung.legacy23.version>2.3.1</xrechnung.legacy23.version>
    <xrechnung.legacy23.release>2023-05-12</xrechnung.legacy23.release>
    <xrechnung.legacy23.sha256>631c975abe8a7aa8258c5192fa68bc2d629cdfca1109379fac1349c079baae7a</xrechnung.legacy23.sha256>
    <!-- Declared as resource directory so IDE builds, which skip Maven plugins, still copy the archive. -->
    <xrechnung.resources>${project.build.directory}/generated-resources/xrechnung</xrechnung.resources>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
        <includes>
          <include>**/xrechnung-rules.properties</include>
        </includes>
      </resource>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>false</filtering>
        <excludes>
          <exclude>**/xrechnung-rules.properties</exclude>
        </excludes>
      </resource>
      <resource>
        <directory>${xrechnung.resources}</directory>
        <filtering>false</filtering>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>com.googlecode.maven-download-plugin</groupId>
        <artifactId>download-maven-plugin</artifactId>
        <version>${plugin.download.version}</version>
        <executions>
          <execution>
            <id>download-xrechnung-bundle</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>wget</goal>
            </goals>
            <configuration>
              <uri>
                https://github.com/itplr-kosit/validator-configuration-xrechnung/releases/download/v${xrechnung.release}/${xrechnung.artifact}.zip
              </uri>
              <outputDirectory>${xrechnung.resources}/io/github/nalukit/paniolo/rules/xrechnung</outputDirectory>
              <outputFileName>${xrechnung.artifact}.zip</outputFileName>
              <sha256>${xrechnung.sha256}</sha256>
              <unpack>false</unpack>
            </configuration>
          </execution>
          <execution>
            <id>download-xrechnung-1.2-bundle</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>wget</goal>
            </goals>
            <configuration>
              <uri>
                https://github.com/itplr-kosit/validator-configuration-xrechnung/releases/download/release-${xrechnung.legacy12.release}/validator-configuration-xrechnung_${xrechnung.legacy12.version}_${xrechnung.legacy12.release}.zip
              </uri>
              <outputDirectory>${xrechnung.resources}/io/github/nalukit/paniolo/rules/xrechnung</outputDirectory>
              <outputFileName>
                validator-configuration-xrechnung_${xrechnung.legacy12.version}_${xrechnung.legacy12.release}.zip
              </outputFileName>
              <sha256>${xrechnung.legacy12.sha256}</sha256>
              <unpack>false</unpack>
            </configuration>
          </execution>
          <execution>
            <id>download-xrechnung-2.0-bundle</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>wget</goal>
            </goals>
            <configuration>
              <uri>
                https://github.com/itplr-kosit/validator-configuration-xrechnung/releases/download/release-${xrechnung.legacy20.release}/validator-configuration-xrechnung_${xrechnung.legacy20.version}_${xrechnung.legacy20.release}.zip
              </uri>
              <outputDirectory>${xrechnung.resources}/io/github/nalukit/paniolo/rules/xrechnung</outputDirectory>
              <outputFileName>
                validator-configuration-xrechnung_${xrechnung.legacy20.version}_${xrechnung.legacy20.release}.zip
              </outputFileName>
              <sha256>${xrechnung.legacy20.sha256}</sha256>
              <unpack>false</unpack>
            </configuration>
          </execution>
          <execution>
            <id>download-xrechnung-2.1-bundle</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>wget</goal>
            </goals>
            <configuration>
              <uri>
                https://github.com/itplr-kosit/validator-configuration-xrechnung/releases/download/release-${xrechnung.legacy21.release}/validator-configuration-xrechnung_${xrechnung.legacy21.version}_${xrechnung.legacy21.release}.zip
              </uri>
              <outputDirectory>${xrechnung.resources}/io/github/nalukit/paniolo/rules/xrechnung</outputDirectory>
              <outputFileName>
                validator-configuration-xrechnung_${xrechnung.legacy21.version}_${xrechnung.legacy21.release}.zip
              </outputFileName>
              <sha256>${xrechnung.legacy21.sha256}</sha256>
              <unpack>false</unpack>
            </configuration>
          </execution>
          <execution>
            <id>download-xrechnung-2.2-bundle</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>wget</goal>
            </goals>
            <configuration>
              <uri>
                https://github.com/itplr-kosit/validator-configuration-xrechnung/releases/download/release-${xrechnung.legacy22.release}/validator-configuration-xrechnung_${xrechnung.legacy22.version}_${xrechnung.legacy22.release}.zip
              </uri>
              <outputDirectory>${xrechnung.resources}/io/github/nalukit/paniolo/rules/xrechnung</outputDirectory>
              <outputFileName>
                validator-configuration-xrechnung_${xrechnung.legacy22.version}_${xrechnung.legacy22.release}.zip
              </outputFileName>
              <sha256>${xrechnung.legacy22.sha256}</sha256>
              <unpack>false</unpack>
            </configuration>
          </execution>
          <execution>
            <id>download-xrechnung-2.3-bundle</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>wget</goal>
            </goals>
            <configuration>
              <uri>
                https://github.com/itplr-kosit/validator-configuration-xrechnung/releases/download/release-${xrechnung.legacy23.release}/validator-configuration-xrechnung_${xrechnung.legacy23.version}_${xrechnung.legacy23.release}.zip
              </uri>
              <outputDirectory>${xrechnung.resources}/io/github/nalukit/paniolo/rules/xrechnung</outputDirectory>
              <outputFileName>
                validator-configuration-xrechnung_${xrechnung.legacy23.version}_${xrechnung.legacy23.release}.zip
              </outputFileName>
              <sha256>${xrechnung.legacy23.sha256}</sha256>
              <unpack>false</unpack>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
