<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.nalukit</groupId>
    <artifactId>paniolo-parent</artifactId>
    <version>${revision}</version>
  </parent>

  <artifactId>paniolo-pdf-layout</artifactId>

  <name>paniolo-pdf-layout</name>
  <description>Renders the visual PDF/A-3 document of an invoice from the Paniolo model, so Factur-X / ZUGFeRD invoices need no
    PDF of their own (Apache PDFBox)
  </description>

  <dependencies>
    <dependency>
      <groupId>io.github.nalukit</groupId>
      <artifactId>paniolo</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- toFacturX(invoice, profile) renders the PDF and embeds the XML. -->
    <dependency>
      <groupId>io.github.nalukit</groupId>
      <artifactId>paniolo-facturx</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.pdfbox</groupId>
      <artifactId>pdfbox</artifactId>
      <version>${pdfbox.version}</version>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- PDF/A conformance checks in tests only; veraPDF is GPLv3+/MPL-2.0 dual licensed. -->
    <dependency>
      <groupId>org.verapdf</groupId>
      <artifactId>validation-model</artifactId>
      <version>${verapdf.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.github.nalukit</groupId>
      <artifactId>paniolo-pdfa</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
