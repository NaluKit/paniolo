<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.nalukit</groupId>
    <artifactId>paniolo-parent</artifactId>
    <version>${revision}</version>
  </parent>

  <artifactId>paniolo-mustang</artifactId>

  <name>paniolo-mustang</name>
  <description>Optional adapter for migrations from Mustangproject: maps a Mustang invoice (IExportableTransaction) to the Paniolo model</description>

  <properties>
    <!-- Compiled and tested against this Mustang release; the application brings its own Mustang. -->
    <mustang.version>2.26.0</mustang.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>io.github.nalukit</groupId>
      <artifactId>paniolo-shared-model</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.mustangproject</groupId>
      <artifactId>library</artifactId>
      <version>${mustang.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>io.github.nalukit</groupId>
      <artifactId>paniolo</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
